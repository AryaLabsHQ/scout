SCOUT_AGENT_TOKENS=node-server=test-token-server,node-k3s=test-token-k3s,node-docker=test-token-docker,node-minimal=test-token-minimal
SCOUT_DB_PATH=./test.db
SCOUT_HOST=127.0.0.1
SCOUT_PORT=3001
SCOUT_AUTH=disabled
