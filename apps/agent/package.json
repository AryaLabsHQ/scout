    "@scout/plugin-sdk": "workspace:*",
    "@scout/shared": "workspace:*",
    "effect": "4.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "^25.1.0",
    "bun-types": "^1.4.2",
    "typescript": "^6.0.2",
    "vitest": "^5.0.3"
  }
}
