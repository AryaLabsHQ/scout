{
  "name": "@scout/agent",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "build": "bun build --compile src/main.ts --outfile dist/scout-agent",
    "typecheck": "tsgo --noEmit",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest"
  },
  "dependencies": {
