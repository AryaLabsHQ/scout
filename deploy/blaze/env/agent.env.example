# ~/.config/scout/agent.env (chmod 600). Read by scout-agent.service.
# The unit already sets SCOUT_HUB_URL, SCOUT_HOSTNAME=blaze, SCOUT_PLUGIN_DIR,
# KUBECONFIG=/dev/null, the edge endpoints and NODE_ENV=production; set them
# here only to override.

# Required. The blaze entry of SCOUT_AGENT_TOKENS in Agni's hub.env. Blank
# values are refused.
SCOUT_TOKEN=

# Optional. Collection interval in seconds.
# SCOUT_INTERVAL=15

# Optional. debug | info | warn | error.
# SCOUT_LOG_LEVEL=info
