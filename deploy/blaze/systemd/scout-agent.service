# Scout agent for Blaze: collectors + systemd and edge plugins, connected to the
# hub on Agni over the tailnet.
# Install: deploy/blaze/README.md
[Unit]
Description=Scout agent (blaze)
Documentation=file:///home/ubuntu/Developer/AryaLabsHQ/scout/deploy/blaze/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/Developer/AryaLabsHQ/scout/apps/agent
Environment=NODE_ENV=production
# Agni's Caddy tailnet listener, which routes only /ws/rpc/agent to the hub.
Environment=SCOUT_HUB_URL=https://agni.jaguar-pride.ts.net:3902
Environment=SCOUT_HOSTNAME=blaze
Environment=SCOUT_PLUGIN_DIR=/home/ubuntu/Developer/AryaLabsHQ/scout/packages
# Blaze runs no cluster. An empty kubeconfig stops the k8s plugin from acting
# on another cluster through a kubeconfig in ~/.kube. Because kubectl is
# installed, the plugin still reports degraded and its collections fail.
Environment=KUBECONFIG=/dev/null
# Edge plugin: the blaze-host tunnel's metrics server. Blaze has no Caddy.
Environment=SCOUT_EDGE_CLOUDFLARED_METRICS=blaze-host=http://127.0.0.1:2002
Environment=SCOUT_EDGE_CADDY_ADMIN=off
EnvironmentFile=%h/.config/scout/agent.env
ExecStart=%h/.bun/bin/bun src/main.ts
Restart=on-failure
RestartSec=5
# The agent never escalates: systemd mutations of system units are allowed only
# for the dotfiles polkit allowlist and otherwise fail with permission-denied.
NoNewPrivileges=yes

[Install]
WantedBy=default.target
