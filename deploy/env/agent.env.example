# ~/.config/scout/agent.env (chmod 600). Read by scout-agent.service.
# The unit already sets SCOUT_HUB_URL=ws://127.0.0.1:3901, SCOUT_PLUGIN_DIR,
# KUBECONFIG=~/.config/scout/kubeconfig and NODE_ENV=production; set them here
# only to override.

# Required. This host's entry in the hub's SCOUT_AGENT_TOKENS. Blank values are
# refused.
SCOUT_TOKEN=

# Optional. The hostname this agent registers as; it must match its
# SCOUT_AGENT_TOKENS entry. Defaults to the OS hostname.
# SCOUT_HOSTNAME=

# Optional. A remote hub, e.g. wss://hub.example.internal:3902 (see "Remote
# agents" in deploy/README.md).
# SCOUT_HUB_URL=

# Optional. Collection interval in seconds.
# SCOUT_INTERVAL=15

# Optional. Comma-separated core collector ids to disable or force-enable.
# SCOUT_COLLECTORS_DISABLE=
# SCOUT_COLLECTORS_ENABLE=

# Optional. Edge plugin endpoints: comma-separated `name=url` or `url`, or `off`.
# Unset probes cloudflared's default 127.0.0.1:20241 and Caddy's 127.0.0.1:2019.
# SCOUT_EDGE_CLOUDFLARED_METRICS=host-tunnel=http://127.0.0.1:2002
# SCOUT_EDGE_CADDY_ADMIN=http://127.0.0.1:2019

# Optional. debug | info | warn | error.
# SCOUT_LOG_LEVEL=info
