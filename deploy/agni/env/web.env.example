# ~/.config/scout/web.env. Read by scout-web.service.
# The unit already sets NITRO_HOST=127.0.0.1, NITRO_PORT=3900,
# SCOUT_HUB_URL=http://127.0.0.1:3901 and NODE_ENV=production. Nothing is
# required here; the file exists so overrides do not need a unit edit.

# Hub base URL for server-side rendering and server functions. They forward
# the visitor's Cf-Access-Jwt-Assertion header (or CF_Authorization cookie) so
# the hub can authenticate them. Browsers never use this URL: they open
# /ws/rpc on the page origin, which Caddy routes to the hub.
# SCOUT_HUB_URL=http://127.0.0.1:3901

# Listener for the nitro server; Caddy proxies everything that is not
# /api/*, /ws/* or /health here.
# NITRO_HOST=127.0.0.1
# NITRO_PORT=3900
