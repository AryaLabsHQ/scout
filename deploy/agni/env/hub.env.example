# ~/.config/scout/hub.env (chmod 600). Read by scout-hub.service.
# The unit already sets SCOUT_HOST=127.0.0.1, SCOUT_PORT=3901,
# SCOUT_DB_PATH=~/.local/state/scout/scout.db, SCOUT_PLUGIN_DIR and
# NODE_ENV=production; set them here only to override.

# Required. Shared secret agents present on /ws/rpc/agent (Authorization:
# Bearer header and agent.connect payload). Must equal agent.env's value.
# Generate: openssl rand -hex 32
SCOUT_TOKEN=

# Required for browser auth (Cloudflare Access app "Scout" on scout.arya.sh).
# Team domain, without scheme.
SCOUT_ACCESS_TEAM_DOMAIN=aryalabs.cloudflareaccess.com
# Application Audience (AUD) tag: Zero Trust > Access > Applications > Scout >
# Overview. Not a secret, but specific to the Access application.
SCOUT_ACCESS_AUD=

# Optional. "access" (default) or "disabled". "disabled" is refused unless
# SCOUT_HOST is a loopback address; it is for local development and e2e only.
# SCOUT_AUTH=access

# Test-only. Overrides the JWKS URL (default
# https://<team domain>/cdn-cgi/access/certs). Never set in production.
# SCOUT_ACCESS_CERTS_URL=

# Optional. debug | info | warn | error.
# SCOUT_LOG_LEVEL=info

# Optional operator (LLM) settings; see docs/architecture.md. Provider API keys
# use the provider's standard variable, e.g. ANTHROPIC_API_KEY or OPENAI_API_KEY.
# SCOUT_OPERATOR_MODEL_PROVIDER=
# SCOUT_OPERATOR_MODEL_ID=
# SCOUT_OPERATOR_THINKING_LEVEL=medium
# SCOUT_OPERATOR_SYSTEM_PROMPT=
# SCOUT_OPERATOR_SKILLS_DIRS=
