# ~/.config/scout/agent.env (chmod 600). Read by scout-agent.service.
# The unit already sets SCOUT_HUB_URL=ws://127.0.0.1:3901, SCOUT_HOSTNAME=agni,
# SCOUT_PLUGIN_DIR, KUBECONFIG=~/.config/scout/kubeconfig and
# NODE_ENV=production; set them here only to override.

# Required. Must equal SCOUT_TOKEN in hub.env. Blank values are refused.
SCOUT_TOKEN=

# Optional. Collection interval in seconds.
# SCOUT_INTERVAL=15

# Optional. Comma-separated core collector ids to disable or force-enable.
# SCOUT_COLLECTORS_DISABLE=
# SCOUT_COLLECTORS_ENABLE=

# Optional. debug | info | warn | error.
# SCOUT_LOG_LEVEL=info
