# Scout on Agni. Add to the dotfiles Caddyfile at deploy time.
#
# Cloudflare Access (app "Scout") authenticates every request before the
# agni-host tunnel delivers it to Caddy on 127.0.0.1:80; Access adds
# Cf-Access-Jwt-Assertion and the CF_Authorization cookie, which pass through
# unchanged and are verified again by the hub.
http://scout.arya.sh {
	# The agent endpoint is loopback-only; local agents dial the hub directly.
	handle /ws/rpc/agent {
		respond 404
	}

	@hub path /api/* /ws/* /health
	handle @hub {
		reverse_proxy 127.0.0.1:3901
	}

	handle {
		reverse_proxy 127.0.0.1:3900
	}
}
